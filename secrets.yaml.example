# Vorlage: diese Datei nach secrets.yaml kopieren und ausfuellen.
# secrets.yaml steht in der .gitignore und gehoert nicht ins Repository.

wifi_ssid: "MeinWLAN"
wifi_password: "geheim"

# API-Verschluesselungsschluessel des Geraets: 32 Byte Base64.
# ESPHome erzeugt ihn beim Anlegen eines neuen Geraets.
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Passwort des Fallback-Hotspots, den das Geraet ohne WLAN aufspannt.
ap_password: "fallback-passwort"
